# Copy this file to .env and set the URL of the TaskTracker backend.
# Android emulator: use 10.0.2.2 to reach your computer, e.g. http://10.0.2.2:<port>
# iOS simulator:    http://localhost:<port>
# Physical device:  http://<your-computer-LAN-IP>:<port>
EXPO_PUBLIC_API_URL=

# Demo mode (development only): set to true to use sample boards stored in memory on the device
# instead of the backend. The backend has no board/task/member queries yet. It is also used
# automatically when EXPO_PUBLIC_API_URL above is empty.
EXPO_PUBLIC_MOBILE_DEMO_MODE=false
