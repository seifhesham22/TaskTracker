# Copy this file to .env to override the defaults in docker-compose.yml.
# .env is gitignored — never commit real passwords.
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=tasktracker
POSTGRES_PORT=5433
API_PORT=8080
FRONTEND_PORT=3000
# Key that signs login tokens (JWT). At least 32 characters.
JWT_KEY=local-development-jwt-signing-key-change-me-0123456789
